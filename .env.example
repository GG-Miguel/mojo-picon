# Variable names only. Real values live in Secret Manager (Cloud Run) and in
# protected, masked GitLab CI/CD variables. Never commit a .env file.

# Google Cloud
# Read by src/mojo_picon/config.py. Not secrets: environment, project ID, regions and model.
ENVIRONMENT=development
GCP_PROJECT_ID=mojo-picon
GCP_REGION=europe-west1
FIRESTORE_DATABASE=mojopicon
# Gemini on Vertex AI through the EU multi-region endpoint (EU data residency)
VERTEX_LOCATION=eu
VERTEX_ENDPOINT=https://aiplatform.eu.rep.googleapis.com
GEMINI_MODEL=gemini-3.8-flash
# Another model for one role, on the same endpoint (empty or unset: the default, config.Settings.role_models:
# the guardian on gemini-3.5-flash-lite, the rest on GEMINI_MODEL). Measured with the evaluation first.
MODEL_COACH=
MODEL_PLANNER=
MODEL_GUARDIAN=
MODEL_VISION=
# AI gateway (LiteLLM): if a Gemini call fails or times out, the same call goes to the fallback models in
# order, on the EU endpoint (ADR-04). LLM_GATEWAY=direct calls Gemini without LiteLLM; FALLBACK_MODELS= (empty), no fallback.
LLM_GATEWAY=litellm
FALLBACK_MODELS=gemini-3.5-flash,claude-haiku-4-5@20251001
FALLBACK_LOCATION=eu
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_LOCATION=eu
EMBEDDING_ENDPOINT=https://aiplatform.eu.rep.googleapis.com

# Langfuse (EU region)
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Qdrant Cloud (RAG). The URL is not secret; the API key is (Secret Manager: qdrant-api-key)
QDRANT_URL=
QDRANT_API_KEY=

# Evaluation judge (G-Eval): GPT-OSS 120B on Groq's free tier. Synthetic test cases only, never user data
GROQ_API_KEY=

# Development only (refused when ENVIRONMENT=production)
STORE=memory
API_DEV_TOKENS=
MCP_DEV_TOKENS=
# Who to write to for data rights, shown in the privacy policy (empty: a generic text)
PRIVACY_CONTACT=
