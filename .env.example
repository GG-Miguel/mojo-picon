# Variable names only. Real values live in Secret Manager (Cloud Run) and in
# protected, masked GitLab CI/CD variables. Never commit a .env file.

# Google Cloud
# Read by src/mojo_picon/config.py. Not secrets: environment, project ID, regions and model.
ENVIRONMENT=development
GCP_PROJECT_ID=mojo-picon
GCP_REGION=europe-west1
FIRESTORE_DATABASE=mojopicon
# Gemini on Vertex AI through the EU multi-region endpoint (EU data residency)
VERTEX_LOCATION=eu
VERTEX_ENDPOINT=https://aiplatform.eu.rep.googleapis.com
GEMINI_MODEL=gemini-3.8-flash

# Langfuse (EU region)
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Qdrant Cloud (RAG)
QDRANT_URL=
QDRANT_API_KEY=

# Anthropic (G-Eval judge; evaluation only, never user data)
ANTHROPIC_API_KEY=

# Development only (refused when ENVIRONMENT=production)
STORE=memory
API_DEV_TOKENS=
MCP_DEV_TOKENS=
