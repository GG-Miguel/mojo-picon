# Variable names only. Real values live in Secret Manager (Cloud Run) and in
# protected, masked GitLab CI/CD variables. Never commit a .env file.

# Google Cloud
# Read by src/mojo_picon/config.py. Not secrets: environment, project ID, regions and model.
ENVIRONMENT=development
GCP_PROJECT_ID=mojo-picon
GCP_REGION=europe-west1
FIRESTORE_DATABASE=mojopicon
# Gemini on Vertex AI through the EU multi-region endpoint (EU data residency)
VERTEX_LOCATION=eu
VERTEX_ENDPOINT=https://aiplatform.eu.rep.googleapis.com
GEMINI_MODEL=gemini-3.8-flash
# Plan B if the EU endpoint is slow (still EU data residency, ADR-04; gemini-2.5-flash retires on 2026-10-20):
#   VERTEX_LOCATION=europe-west1  VERTEX_ENDPOINT=https://europe-west1-aiplatform.googleapis.com  GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_LOCATION=eu
EMBEDDING_ENDPOINT=https://aiplatform.eu.rep.googleapis.com

# Langfuse (EU region)
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Qdrant Cloud (RAG). The URL is not secret; the API key is (Secret Manager: qdrant-api-key)
QDRANT_URL=
QDRANT_API_KEY=

# Anthropic (G-Eval judge; evaluation only, never user data)
ANTHROPIC_API_KEY=

# Development only (refused when ENVIRONMENT=production)
STORE=memory
API_DEV_TOKENS=
MCP_DEV_TOKENS=
