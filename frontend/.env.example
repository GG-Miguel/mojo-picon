# Firebase web config (public by design: it identifies the project, it is not a secret)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=mojo-picon
VITE_FIREBASE_APP_ID=

# Local development without Firebase login: a token from API_DEV_TOKENS (api/dev.py).
# Never set in production builds.
VITE_DEV_TOKEN=
