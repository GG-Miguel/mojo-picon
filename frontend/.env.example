# Firebase web config (public by design: it identifies the project, it is not a secret).
# Kept out of the repository anyway, because secret scanners flag the AIza… key:
#   - local: copy this file to .env.local (git-ignored) and fill it in;
#   - production: GitLab CI/CD variables VITE_FIREBASE_API_KEY, VITE_FIREBASE_AUTH_DOMAIN and
#     VITE_FIREBASE_APP_ID, passed to Cloud Build as build arguments (deploy job).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=mojo-picon
VITE_FIREBASE_APP_ID=

# Local development without Firebase login: a token from API_DEV_TOKENS (api/dev.py).
# Never set in production builds.
VITE_DEV_TOKEN=
